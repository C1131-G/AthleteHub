generator client {
  provider = "prisma-client"
  output   = "../electron/generated"
}

datasource db {
  provider = "sqlite"
}

model BackendProbe {
  id        String   @id
  label     String
  createdAt DateTime
}

model OwnerAccount {
  id             String    @id
  username       String    @unique
  passwordHash   Bytes
  passwordSalt   Bytes
  recoveryHash   Bytes
  recoverySalt   Bytes
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime
  updatedAt      DateTime
}

model ArcherySession {
  id               String       @id
  athleteId        String
  date             String
  kind             String
  status           String
  formatSnapshot   String
  equipmentSetupId String?
  plannedArrows    Int?
  actualArrows     Int?
  durationMin      Int?
  rpe              Int?
  technicalFocus   String
  notes            String
  createdAt        DateTime
  updatedAt        DateTime
  ends             ArcheryEnd[]

  @@index([athleteId, date])
}

model ArcheryEnd {
  id         String         @id
  sessionId  String
  sequence   Int
  arrowCount Int
  score      Int
  arrows     ArcheryArrow[]
  session    ArcherySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, sequence])
}

model ArcheryArrow {
  id       String     @id
  endId    String
  sequence Int
  score    Int
  // Normalised -1…1 on the target face; a score can be recorded un-plotted.
  x        Float?
  y        Float?
  end      ArcheryEnd @relation(fields: [endId], references: [id], onDelete: Cascade)

  @@unique([endId, sequence])
}

// Collections migrated off localStorage.
//
// `*Snapshot` holds the complete Zod-validated record and is the only field the
// decoders read; the sibling columns are derived copies that exist so SQLite can
// index, sort, and enforce uniqueness. Writing both from one parsed value keeps
// them from diverging.

model Athlete {
  id              String    @id
  code            String    @unique
  fullName        String
  category        String
  status          String
  dateOfBirth     String
  profileSnapshot String
  archivedAt      DateTime?
  createdAt       DateTime
  updatedAt       DateTime

  @@index([archivedAt, fullName])
}

model EquipmentSetup {
  id            String    @id
  athleteId     String
  recordedAt    String
  itemsSnapshot String
  archivedAt    DateTime?
  createdAt     DateTime
  updatedAt     DateTime

  @@index([athleteId, recordedAt])
}

model WeeklyReport {
  id             String    @id
  athleteId      String
  weekStart      String
  status         String
  reportSnapshot String
  archivedAt     DateTime?
  createdAt      DateTime
  updatedAt      DateTime

  @@unique([athleteId, weekStart])
  @@index([athleteId, weekStart])
}

model MonthlyReport {
  id             String    @id
  athleteId      String
  month          String
  reportSnapshot String
  archivedAt     DateTime?
  createdAt      DateTime
  updatedAt      DateTime

  @@unique([athleteId, month])
}

model Assessment {
  id              String    @id
  athleteId       String
  date            String
  type            String
  weeklyReportId  String?
  payloadSnapshot String
  archivedAt      DateTime?
  createdAt       DateTime
  updatedAt       DateTime

  @@index([athleteId, date])
}

model ConditioningAssessment {
  id              String    @id
  athleteId       String
  date            String
  resultsSnapshot String
  archivedAt      DateTime?
  createdAt       DateTime
  updatedAt       DateTime

  @@index([athleteId, date])
}

model ConditioningProgramme {
  id             String    @id
  athleteId      String
  startDate      String
  endDate        String
  status         String
  phasesSnapshot String
  archivedAt     DateTime?
  createdAt      DateTime
  updatedAt      DateTime

  @@index([athleteId, startDate])
}

model TrainingPlan {
  id           String    @id
  athleteId    String
  seasonStart  String
  seasonEnd    String
  status       String
  planSnapshot String
  archivedAt   DateTime?
  createdAt    DateTime
  updatedAt    DateTime

  @@index([athleteId, seasonStart])
}

model MonthlyCycle {
  id            String    @id
  athleteId     String
  month         String
  completedAt   DateTime?
  stepsSnapshot String
  archivedAt    DateTime?
  createdAt     DateTime
  updatedAt     DateTime

  @@unique([athleteId, month])
}

model SightMark {
  id         String    @id
  athleteId  String
  bow        String
  arrow      String
  distanceM  Float
  mark       String
  note       String
  snapshot   String
  archivedAt DateTime?
  createdAt  DateTime
  updatedAt  DateTime

  @@index([athleteId, bow, arrow])
  @@unique([athleteId, bow, arrow, distanceM])
}

model WellnessEntry {
  id         String    @id
  athleteId  String
  date       String
  sleep      Int
  soreness   Int
  fatigue    Int
  stress     Int
  mood       Int
  note       String
  snapshot   String
  archivedAt DateTime?
  createdAt  DateTime
  updatedAt  DateTime

  @@index([athleteId, date])
  @@unique([athleteId, date])
}
