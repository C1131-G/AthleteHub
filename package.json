{
  "name": "AthleteHub",
  "version": "0.0.3",
  "private": true,
  "description": "Offline-first training log for athletes and coaches.",
  "homepage": "https://github.com/C1131-G/AthleteHub",
  "license": "UNLICENSED",
  "author": {
    "name": "CIBI",
    "email": "abilazlee@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/C1131-G/AthleteHub.git"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "backend:build": "bun run prisma:generate && node scripts/build-backend.mjs",
    "build": "next build && bun run backend:build",
    "check": "ultracite check",
    "clean": "node scripts/clean.mjs",
    "clean:all": "node scripts/clean.mjs --all",
    "dev": "next dev",
    "dist:prepare": "bun run clean && bun run prisma:generate && bun run build && bun run standalone",
    "electron:dev": "bun run backend:build && electronmon electron/main.cjs",
    "electron:preview": "bun run build && bun run standalone && electron electron/main.cjs --production",
    "fix": "ultracite fix",
    "instant:server": "node scripts/instant-nav-server.mjs",
    "package": "bun run dist:prepare && electron-builder",
    "package:dir": "bun run dist:prepare && electron-builder --dir",
    "package:linux": "bun run dist:prepare && electron-builder --linux",
    "package:mac": "bun run dist:prepare && electron-builder --mac",
    "package:win": "bun run dist:prepare && electron-builder --win",
    "prepare": "lefthook install",
    "pretest": "bun run prisma:generate",
    "pretypecheck": "bun run prisma:generate && next typegen",
    "prisma:generate": "prisma generate",
    "release": "bun run dist:prepare && electron-builder --publish always",
    "standalone": "bun scripts/prepare-standalone.mjs",
    "start": "next start",
    "test": "bun test electron features lib",
    "test:instant": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@libsql/client": "^0.18.0",
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/adapter-libsql": "7.10.0",
    "@prisma/client": "7.10.0",
    "@tanstack/charts": "0.16.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-store": "^0.11.1",
    "@tanstack/react-table": "9.2.4",
    "@tanstack/store": "^0.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "electron-updater": "6",
    "motion": "^13.1.1",
    "next": "16.3.3",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@next/bundle-analyzer": "16.3.3",
    "@next/playwright": "16.3.3",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "bun-types": "^1.4.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electronmon": "^2.0.4",
    "lefthook": "^2.1.12",
    "lint-staged": "^17.4.1",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "oxlint-plugin-react-doctor": "^0.9.12",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "typescript": "7.0.2",
    "ultracite": "7.10.7"
  },
  "intent": {
    "skills": [
      "@tanstack/*"
    ]
  }
}
